#!/usr/bin/env python3
"""ask-llm [-m qwen|deepseek|glm] [-t max_tokens] [--think] [-f file ...] "prompt"
Sends prompt (+ optional file contents) to a local Nvidia-hosted model; prints the answer."""
import argparse, json, sys, urllib.request
EP = {"qwen": ("http://10.40.0.248:8000", "local"),
      "deepseek": ("http://10.40.3.193:8300", "deepseek-v4.1-flash"),
      "glm": ("http://10.40.3.192:8200", "glm-5.3-flash")}
ap = argparse.ArgumentParser(); ap.add_argument("-m", default="qwen", choices=EP)
ap.add_argument("-t", type=int, default=8000); ap.add_argument("--think", action="store_true")
ap.add_argument("-f", nargs="*", default=[]); ap.add_argument("prompt")
a = ap.parse_args()
content = a.prompt
for f in a.f:
    content += f"\n\n===== {f} =====\n" + open(f).read()
url, model = EP[a.m]
body = {"model": model, "messages": [{"role": "user", "content": content}], "max_tokens": a.t,
        "temperature": 0.2, "chat_template_kwargs": {"enable_thinking": a.think}}
req = urllib.request.Request(url + "/v1/chat/completions", json.dumps(body).encode(), {"Content-Type": "application/json"})
d = json.load(urllib.request.urlopen(req, timeout=1800))
print(d["choices"][0]["message"]["content"])
print(f"[{a.m}: {d['usage']['prompt_tokens']} in / {d['usage']['completion_tokens']} out]", file=sys.stderr)
