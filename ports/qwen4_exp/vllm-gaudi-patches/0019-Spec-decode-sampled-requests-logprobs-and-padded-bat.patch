+# SPDX-License-Identifier: Apache-2.0
+"""The HPU rejection sampler on padded batches: tokens, distribution, penalties and logprobs."""
+
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+from vllm.v1.outputs import LogprobsTensors
+from vllm_gaudi.v1._vendored.sample.metadata import SamplingMetadata
+from vllm_gaudi.v1._vendored.sample.rejection_sampler import RejectionSampler
+from vllm_gaudi.v1._vendored.sample.sampler import Sampler
+from vllm_gaudi.v1.sample.hpu_rejection_sampler import grid_metadata
+from vllm_gaudi.v1.worker.hpu_model_runner import HPUModelRunner
+
+VOCAB = 12
+
+
+def _params(batch_size, temperature=None, top_k=None, top_p=None, **kwargs):
+    temperature = torch.zeros(batch_size) if temperature is None else temperature
+    ones = torch.ones(batch_size)
+    fields = dict(temperature=temperature,
+                  all_greedy=bool((temperature == 0).all()),
+                  all_random=bool((temperature > 0).all()),
+                  top_p=top_p,
+                  top_k=top_k,
+                  generators={},
+                  max_num_logprobs=None,
+                  no_penalties=True,
+                  prompt_token_ids=None,
+                  frequency_penalties=ones * 0,
+                  presence_penalties=ones * 0,
+                  repetition_penalties=ones,
+                  output_token_ids=[[] for _ in range(batch_size)],
+                  allowed_token_ids_mask=None,
+                  bad_words_token_ids={},
+                  logitsprocs=SimpleNamespace(non_argmax_invariant=[], argmax_invariant=[]))
+    fields.update(kwargs)
+    return SamplingMetadata(**fields)
+
+
+def _sample(logits, drafts, width, params):
+    """What the runner does, from its [batch * width, 1] token ids to the parsed output."""
+    batch_size = len(drafts)
+    runner = SimpleNamespace(device=torch.device("cpu"),
+                             arange_np=np.arange(batch_size * width),
+                             input_batch=SimpleNamespace(req_id_to_index={str(i): i for i in range(batch_size)}))
+    runner._get_cumsum_and_arange = lambda *a, **k: HPUModelRunner._get_cumsum_and_arange(runner, *a, **k)
+    scheduled = SimpleNamespace(scheduled_spec_decode_tokens={str(i): d for i, d in enumerate(drafts) if d})
+    token_ids = torch.tensor([[t] for d in drafts for t in ([0] + d + [0] * width)[:width]], dtype=torch.int32)
+    logits_indices, metadata = HPUModelRunner._prepare_spec_decode_inputs(runner, scheduled, torch.arange(batch_size),
+                                                                          token_ids, width)
+    if metadata is None:
+        # No drafts at all: not a speculative step
+        return None
+    # The padded rows hold the last row, as after hidden_states[logits_indices]
+    logits = logits[logits_indices]
+    width = logits.shape[0] // batch_size
+    out = RejectionSampler(Sampler())(grid_metadata(metadata, width), None, logits.clone(), params)
+    return RejectionSampler.parse_output(out.sampled_token_ids, VOCAB)[0], out.logprobs_tensors
+
+
+def _expected(best, drafts, width):
+    result = []
+    for i, draft in enumerate(drafts):
+        tokens = []
+        for j in range(len(draft) + 1):
+            tokens.append(int(best[i * width + j]))
+            if j < len(draft) and tokens[-1] != draft[j]:
+                break
+        result.append(tokens)
+    return result
+
+
+def _random_case(rng):
+    batch_size, width = int(torch.randint(1, 6, (1, ), generator=rng)), int(torch.randint(2, 6, (1, ), generator=rng))
+    logits = torch.randn(batch_size * width, VOCAB, generator=rng)
+    drafts = []
+    for i in range(batch_size):
+        n = width - 1 if i == batch_size // 2 else int(torch.randint(0, width, (1, ), generator=rng))
+        drafts.append([
+            int(logits[i * width + j].argmax()) if torch.rand(1, generator=rng) < 0.8 else j for j in range(n)
+        ])
+    return batch_size, width, logits, drafts
+
+
+def test_greedy_tokens_and_logprobs_of_padded_batches():
+    rng = torch.Generator().manual_seed(0)
+    for _ in range(500):
+        batch_size, width, logits, drafts = _random_case(rng)
+        tokens, lp = _sample(logits, drafts, width, _params(batch_size, max_num_logprobs=2))
+        assert tokens == _expected(logits.argmax(-1), drafts, width)
+        want = logits.log_softmax(-1)
+        for i, emitted in enumerate(tokens):
+            for j, token in enumerate(emitted):
+                row = i * width + j
+                assert int(lp.logprob_token_ids[row, 0]) == token
+                assert abs(float(lp.logprobs[row, 0]) - float(want[row, token])) < 1e-5
+                assert lp.logprob_token_ids[row, 1:].tolist() == want[row].topk(2).indices.tolist()
+
+
+def test_penalties_see_the_drafts_ahead():
+    rng = torch.Generator().manual_seed(1)
+    for _ in range(300):
+        batch_size, width, logits, drafts = _random_case(rng)
+        prompt = torch.randint(0, VOCAB, (batch_size, 2), generator=rng)
+        outputs = [[int(torch.randint(0, VOCAB, (1, ), generator=rng))] for _ in range(batch_size)]
+        params = _params(batch_size,
+                         no_penalties=False,
+                         repetition_penalties=torch.full((batch_size, ), 1.8),
+                         prompt_token_ids=prompt,
+                         output_token_ids=outputs,
+                         spec_token_ids=[list(d) for d in drafts])
+        best = logits.clone()
+        for i, draft in enumerate(drafts):
+            for j in range(len(draft) + 1):
+                row = best[i * width + j]
+                for token in set(prompt[i].tolist() + outputs[i] + draft[:j]):
+                    row[token] = row[token] / 1.8 if row[token] > 0 else row[token] * 1.8
+        assert _sample(logits, drafts, width, params)[0] == _expected(best.argmax(-1), drafts, width)
+
+
+def test_sampled_requests_follow_the_target_distribution():
+    batch_size, width = 60000, 3
+    base = torch.randn(width, VOCAB, generator=torch.Generator().manual_seed(2))
+    temperature, top_k, top_p = torch.full((batch_size, ), 0.8), torch.full((batch_size, ), 6), torch.full(
+        (batch_size, ), 0.95)
+    first, second = base[:2].argmax(-1).tolist()
+    # Every other request has one draft and a padded row
+    drafts = [[first, second] if i % 2 == 0 else [first] for i in range(batch_size)]
+    torch.manual_seed(3)
+    tokens, _ = _sample(base.repeat(batch_size, 1), drafts, width, _params(batch_size, temperature, top_k, top_p))
+
+    want = base / 0.8
+    want = want.masked_fill(want < want.topk(6).values[:, -1:], -torch.inf).softmax(-1)
+    ordered, order = want.sort(descending=True)
+    keep = ordered.cumsum(-1) - ordered < 0.95
+    want = (ordered * keep / (ordered * keep).sum(-1, keepdim=True)).gather(1, order.argsort(-1))
+    for parity in (0, 1):
+        rows = tokens[parity::2]
+        for position in range(3 if parity == 0 else 2):
+            seen = np.array([t[position] for t in rows if len(t) > position])
+            got = np.bincount(seen, minlength=VOCAB) / len(seen)
+            assert np.abs(got - want[position].numpy()).sum() / 2 < 0.025, (parity, position, len(seen))
+
+
+def test_greedy_requests_next_to_sampled_ones():
+    rng = torch.Generator().manual_seed(4)
+    for _ in range(300):
+        batch_size, width, logits, drafts = _random_case(rng)
+        temperature = torch.tensor([0.0 if i % 2 == 0 else 0.7 for i in range(batch_size)])
+        tokens, _ = _sample(logits, drafts, width, _params(batch_size, temperature))
+        assert tokens[::2] == _expected(logits.argmax(-1), drafts, width)[::2]
+
+
+def test_seeded_requests_repeat():
+    logits = torch.randn(8, VOCAB, generator=torch.Generator().manual_seed(5))
+    runs = []
+    for _ in range(2):
+        generators = {i: torch.Generator().manual_seed(7 + i) for i in range(2)}
+        runs.append(_sample(logits, [[1, 2, 3], [4]], 4, _params(2, torch.ones(2), generators=generators))[0])
+    assert runs[0] == runs[1]
+
+
+def test_logprobs_output_has_a_row_per_token():
+    runner = SimpleNamespace(input_batch=SimpleNamespace(req_id_to_index={"a": 0, "b": 1, "c": 2, "d": 3}))
+    grid = torch.arange(8)
+    spec = HPUModelRunner._spec_decode_logprobs(["b", "a"], [3, 1], 4,
+                                                LogprobsTensors(grid[:, None], grid[:, None].float(), grid))
+    prefill = (["d"], LogprobsTensors(torch.tensor([[90]]), torch.tensor([[9.0]]), torch.tensor([9])))
+    out = HPUModelRunner._build_logprobs_output(runner, [spec, prefill], 4)
+    assert out.slice_request(0, 1).logprob_token_ids.tolist() == [[4]]
+    assert out.slice_request(1, 3).logprob_token_ids.tolist() == [[0], [1], [2]]
+    assert out.slice_request(3, 1).logprob_token_ids.tolist() == [[90]]
