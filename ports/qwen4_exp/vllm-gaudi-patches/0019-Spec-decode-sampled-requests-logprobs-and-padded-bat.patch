 import torch
 from typing import Optional
 from vllm_gaudi.v1._vendored.sample.metadata import SamplingMetadata
@@ -9,6 +12,78 @@ PLACEHOLDER_TOKEN_ID = rejection_sampler.PLACEHOLDER_TOKEN_ID
 GREEDY_TEMPERATURE = rejection_sampler.GREEDY_TEMPERATURE
 
 
+def grid_metadata(metadata: SpecDecodeMetadata, width: int) -> SpecDecodeMetadata:
+    """The metadata in the layout of the HPU logits, for the rejection sampler only.
+
+    The logits are ``[batch * width]`` rows, padded per request, while the sampler expects compact rows. Here every
+    request has ``width - 1`` drafts, of which the padded ones are -1, so that the compact indexing is right.
+    """
+    num_draft_tokens, depth = metadata.num_draft_tokens, width - 1
+    batch_size, device = len(num_draft_tokens), metadata.bonus_logits_indices.device
+    # All rows of a request but its bonus row
+    targets = [i * width + j + (j >= n) for i, n in enumerate(num_draft_tokens) for j in range(depth)]
+    padding = torch.tensor([j >= n for n in num_draft_tokens for j in range(depth)], dtype=torch.bool)
+    steps = torch.arange(1, batch_size + 1, dtype=torch.int32)
+    return replace(metadata,
+                   draft_token_ids=metadata.draft_token_ids.cpu().reshape(-1).masked_fill(padding, PLACEHOLDER_TOKEN_ID),
+                   num_draft_tokens=[depth] * batch_size,
+                   cu_num_draft_tokens=(steps * depth).to(device),
+                   cu_num_sampled_tokens=(steps * width).to(device),
+                   target_logits_indices=torch.tensor(targets, dtype=torch.int32).to(device))
+
+
+def expand_batch_to_tokens(
+    x: torch.Tensor,
+    cu_num_tokens: torch.Tensor,
+    num_tokens: int,
+    replace_from: int = 0,
+    replace_to: int = 0,
+) -> torch.Tensor:
+    """Replaces the Triton kernel. In the grid layout every request has the same number of rows."""
+    assert num_tokens % x.shape[0] == 0, "expected the grid layout, see grid_metadata"
+    if replace_from != replace_to:
+        x = x.masked_fill(x == replace_from, replace_to)
+    return x.repeat_interleave(num_tokens // x.shape[0])
+
+
+def combine_outputs_with_spec_tokens(
+    output_token_ids: list[list[int]],
+    spec_token_ids: Optional[list[list[int]]] = None,
+) -> list[list[int]]:
+    """The tokens ahead of each row of the grid layout."""
+    if spec_token_ids is None:
+        return output_token_ids
+    depth = max(len(spec) for spec in spec_token_ids)
+    return [[*out, *spec[:j]] for out, spec in zip(output_token_ids, spec_token_ids) for j in range(depth)]
+
+
+def sample_target_tokens(target_logits: torch.Tensor, sampling_metadata: SamplingMetadata,
+                         batch_size: int) -> torch.Tensor:
+    """One token per row from the target distribution: argmax, or Gumbel-max for requests with a temperature.
+
+    Accepting a draft iff it equals this token, and otherwise emitting this token, is rejection sampling without
+    draft probabilities: the draft is accepted with its target probability, the replacement follows the rest.
+    """
+    if sampling_metadata.all_greedy:
+        return target_logits.argmax(dim=-1).cpu()
+    depth, vocab_size = target_logits.shape[0] // batch_size, target_logits.shape[-1]
+    generators = sampling_metadata.generators
+    if generators:
+        noise = torch.cat([
+            torch.rand((depth, vocab_size), generator=generators.get(i), device=target_logits.device)
+            for i in range(batch_size)
+        ])
+    else:
+        noise = torch.rand(target_logits.shape, device=target_logits.device)
+    noise = -torch.log(-torch.log(noise.clamp(min=1e-20, max=1 - 1e-7)))
+    sampled = (target_logits + noise).argmax(dim=-1).cpu()
+    if sampling_metadata.all_random:
+        return sampled
+    # Chosen on the CPU: torch.where on integer tensors is not reliable on HPU
+    greedy = (sampling_metadata.temperature.cpu() == GREEDY_TEMPERATURE).repeat_interleave(depth)
+    return torch.where(greedy, target_logits.argmax(dim=-1).cpu(), sampled)
+
+
 def rejection_sample_pytorch(
     padded_draft_token_ids: torch.Tensor,
     padded_target_token_ids: torch.Tensor,
@@ -71,11 +146,12 @@ def rejection_sample_pytorch(
     # 3. Find the first mismatch, ignoring padding tokens
     # Create a mask to only consider valid tokens for each sequence
     pos = torch.arange(max_draft_tokens, device=device)
-    valid_token_mask = pos < num_draft_tokens_per_seq.unsqueeze(-1)
+    valid_token_mask = (pos < num_draft_tokens_per_seq.unsqueeze(-1)) & (padded_draft_token_ids >= 0)
+    num_draft_tokens_per_seq = valid_token_mask.sum(dim=1)
 
     matches = (padded_draft_token_ids == padded_target_token_ids)
 
-    mismatches = ~matches
+    mismatches = ~matches & valid_token_mask
     any_mismatch = mismatches.any(dim=1)
     # For sequence that the num draft tokens is 0, always consider all match
     any_mismatch[num_draft_tokens_per_seq == 0] = False
@@ -146,20 +222,22 @@ def rejection_sample(
     fly_entropy_threshold: Optional[float] = None,
     fly_entropy_top_k: int = 3,
 ) -> torch.Tensor:
-    # NOTE: HPU spec decode only supports greedy sampling, so the
-    # `use_fp64_gumbel` knob (used by the random/gumbel recovery path upstream)
+    # NOTE: the `use_fp64_gumbel` knob (used by the random/gumbel recovery path upstream)
     # is accepted for signature parity but intentionally unused here.
     # The FLy deferred-verification knobs are likewise accepted for parity;
     # FLy itself is not supported on HPU.
-    assert sampling_metadata.all_greedy, "Only greedy sampling is supported."
+    assert draft_probs is None, "Draft probabilities are not supported on HPU."
     assert fly_window_size is None, "FLy speculative decoding is not supported on HPU."
 
-    # Rejection sampling for greedy sampling requests.
-
-    target_argmax = target_probs.argmax(dim=-1)
-    output_token_ids = rejection_sample_pytorch(draft_token_ids, target_argmax, bonus_token_ids, num_draft_tokens,
+    target_token_ids = sample_target_tokens(target_probs, sampling_metadata, len(num_draft_tokens))
+    output_token_ids = rejection_sample_pytorch(draft_token_ids, target_token_ids, bonus_token_ids, num_draft_tokens,
                                                 cu_num_draft_tokens)
+    if sampling_metadata.max_num_logprobs is not None:
+        # The logprobs are gathered with these ids on the device of the logits
+        output_token_ids = output_token_ids.to(target_probs.device)
     return output_token_ids
 
 
 rejection_sampler.rejection_sample = rejection_sample
+rejection_sampler.expand_batch_to_tokens = expand_batch_to_tokens
+rejection_sampler.RejectionSampler._combine_outputs_with_spec_tokens = staticmethod(combine_outputs_with_spec_tokens)
