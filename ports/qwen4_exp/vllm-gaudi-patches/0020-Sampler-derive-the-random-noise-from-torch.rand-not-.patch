From 328e5979e74184199544b532acdc82238fc9a272 Mon Sep 17 00:00:00 2001
From: richard-rhino <richard-rhino@users.noreply.github.com>
Date: Sun, 22 Nov 2026 11:19:11 +0000
Subject: [PATCH] Sampler: derive the random noise from torch.rand, not
 exponential_

On HPU, the values of Tensor.exponential_ are not independent within a row,
although their marginal distribution is right. Sampling with
argmax(probs / noise) then does not follow the probabilities, for every
request with a temperature, with or without speculative decoding.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: richard-rhino <richard-rhino@users.noreply.github.com>
---
 tests/unit_tests/worker/test_random_sample.py | 32 +++++++++++++++++++
 vllm_gaudi/__init__.py                        |  1 +
 vllm_gaudi/v1/sample/hpu_random_sample.py     | 32 +++++++++++++++++++
 3 files changed, 65 insertions(+)
 create mode 100644 tests/unit_tests/worker/test_random_sample.py
 create mode 100644 vllm_gaudi/v1/sample/hpu_random_sample.py

diff --git a/tests/unit_tests/worker/test_random_sample.py b/tests/unit_tests/worker/test_random_sample.py
new file mode 100644
index 00000000..0c9e0192
--- /dev/null
+++ b/tests/unit_tests/worker/test_random_sample.py
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The sampler's random draw follows its probabilities and does not use exponential_."""
+
+from unittest import mock
+
+import torch
+
+from vllm_gaudi.v1._vendored.sample.ops import topk_topp_sampler
+from vllm_gaudi.v1.sample.hpu_random_sample import random_sample
+
+PROBS = torch.tensor([0.35, 0.25, 0.0, 0.15, 0.1, 0.08, 0.07, 0.0])
+
+
+def test_sampler_uses_the_replacement():
+    assert topk_topp_sampler.random_sample is random_sample
+    with mock.patch.object(torch.Tensor, "exponential_", side_effect=AssertionError("exponential_ used")):
+        random_sample(PROBS.repeat(4, 1), {})
+        random_sample(PROBS.repeat(4, 1), {1: torch.Generator().manual_seed(0)})
+
+
+def test_follows_the_probabilities():
+    torch.manual_seed(0)
+    sampled = random_sample(PROBS.repeat(400000, 1), {})
+    got = torch.bincount(sampled, minlength=len(PROBS)) / len(sampled)
+    assert not got[PROBS == 0].any()
+    assert float((got - PROBS).abs().sum() / 2) < 0.005
+
+
+def test_seeded_rows_repeat():
+    rows = PROBS.repeat(64, 1)
+    first, second = (random_sample(rows, {i: torch.Generator().manual_seed(i) for i in range(64)}) for _ in range(2))
+    assert first.tolist() == second.tolist()
