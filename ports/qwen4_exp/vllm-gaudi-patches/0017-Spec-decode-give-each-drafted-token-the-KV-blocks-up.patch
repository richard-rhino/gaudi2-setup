 @pytest.mark.parametrize("width", [1, 2, 4])
@@ -25,6 +25,12 @@ def test_only_scheduled_tokens_reach_live_slots(width, seed):
     assert pos.shape == (3, (n + pad_rows) * width)
     lens = flat_decode_seq_lens(counts + [0] * pad_rows, width)
     assert lens.shape == ((n + pad_rows) * width, ) and lens.view(-1, width).sum(1).tolist() == counts + [0] * pad_rows
+    for start, count in zip(starts, counts):
+        for block_size in (2, 128):
+            rows = decode_row_num_blocks(start, count, width, block_size)
+            assert len(rows) == width
+            assert rows[:count] == [(start + j) // block_size + 1 for j in range(count)]
+            assert set(rows[count:]) <= {start // block_size + 1}
     live = torch.arange(1, n * width + 1).view(n, width)
     slots = live.clone()
     redirect_padded_tokens(slots, counts, itertools.cycle(range(90000, 90128)))
diff --git a/vllm_gaudi/v1/worker/decode_token_padding.py b/vllm_gaudi/v1/worker/decode_token_padding.py
index 5e752a2a..2eb8bb93 100644
--- a/vllm_gaudi/v1/worker/decode_token_padding.py
+++ b/vllm_gaudi/v1/worker/decode_token_padding.py
@@ -21,6 +21,14 @@ def mrope_decode_positions(context_lens: Sequence[int], token_counts: Sequence[i
     return positions.flatten().repeat(3, 1)
 
 
+def decode_row_num_blocks(context_len: int, count: int, width: int, block_size: int) -> list[int]:
+    """``[width]`` KV blocks that each token of one request sees: up to the block of its own position.
+
+    A token can open a new block in the middle of the step. Padded tokens get the first token's blocks.
+    """
+    return [(int(context_len) + (j if j < count else 0)) // block_size + 1 for j in range(width)]
+
+
 def flat_decode_seq_lens(token_counts: Sequence[int], width: int) -> torch.Tensor:
     """``[batch * width]`` lengths of the flattened one-token rows: 1 for a scheduled token, 0 for padding.
 
