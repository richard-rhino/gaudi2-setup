index 00000000..fc30e9e8
--- /dev/null
+++ b/tests/unit_tests/worker/test_drafter_compile.py
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The draft model gets the same regional compilation as the target."""
+
+from types import SimpleNamespace
+from unittest import mock
+
+import torch
+from torch import nn
+
+from vllm_gaudi.v1.worker import hpu_model_runner
+
+
+class _Model(nn.Module):
+
+    def __init__(self):
+        super().__init__()
+        self.layers = nn.ModuleList([nn.Linear(2, 2)])
+
+    def compute_logits(self, hidden_states):
+        return hidden_states
+
+
+def _compiled(drafter, regional=True):
+    runner = object.__new__(hpu_model_runner.HPUModelRunner)
+    runner.model, runner.sampler = _Model(), nn.Identity()
+    runner.vllm_config = SimpleNamespace(model_config=SimpleNamespace(enforce_eager=False))
+    if drafter is not None:
+        runner.drafter = drafter
+    targets = [runner.model, runner.model.layers[0]]
+    if getattr(drafter, "model", None) is not None:
+        targets += [drafter.model, drafter.model.layers[0]]
+    seen = []
+
+    def compile_stub(module, **kwargs):
+        seen.append(getattr(module, "__self__", module))
+        return module
+
+    runner._compile = compile_stub
+    config = SimpleNamespace(regional_compilation=regional)
+    with mock.patch.object(hpu_model_runner, "HPUCompileConfig", return_value=config), \
+            mock.patch.object(hpu_model_runner, "is_fake_hpu", return_value=False), \
+            mock.patch.object(hpu_model_runner.htorch.utils.internal, "is_lazy", return_value=False), \
+            mock.patch.object(hpu_model_runner.Sampler, "apply_logits_processors", lambda *a, **k: None), \
+            mock.patch.object(torch._dynamo.config, "force_parameter_static_shapes", True):
+        runner._maybe_compile(runner.model)
+    return [any(t is s for s in seen) for t in targets]
+
+
+def test_drafter_regions_are_compiled():
+    assert _compiled(SimpleNamespace(model=_Model())) == [True] * 4
+
+
+def test_drafter_is_compiled_without_regional_compilation():
+    assert _compiled(SimpleNamespace(model=_Model()), regional=False) == [True, False, True, False]
+
+
+def test_runner_without_draft_model():
+    assert _compiled(None) == [True] * 2
+    assert _compiled(SimpleNamespace()) == [True] * 2
