@@ -5534,8 +5536,15 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
                 self.sampler = self._compile(self.sampler, fullgraph=False)
             else:
                 self.model = self._compile(self.model)
+                if drafter_model is not None:
