+# SPDX-License-Identifier: Apache-2.0
+"""CPU tests for RecurrentStateSlots: after any prefill chunking and any rejections, load the right token's state."""
+
+from __future__ import annotations
+
+import random
+
+import pytest
+
+from vllm_gaudi.v1.worker.recurrent_state_slots import RecurrentStateSlots
+
+
+@pytest.mark.parametrize("width", [1, 2, 4])
+@pytest.mark.parametrize("seed", range(50))
+def test_resume_state_is_last_kept_token(width, seed):
+    rng = random.Random(seed)
+    reqs, groups = 5, 3
+    slots = RecurrentStateSlots(width)
+    held = [None] * slots.total_rows(reqs, groups)  # row -> (request, group, position) whose state it holds
+    for life in range(4):  # base slots are reused by later requests
+        for base in range(reqs):
+            req, pos = f"{life}-{base}", 0
+            for _ in range(rng.randint(1, 3)):  # prefill chunks
+                n = rng.randint(1, 50)
+                for g in range(groups):
+                    row = slots.row(base, groups, g)
+                    assert pos == 0 or held[row] == (req, g, pos - 1)
+                    held[row] = (req, g, pos + n - 1)
+                slots.prefill_scheduled(req, pos, n)
+                pos += n
+            for _ in range(30):
+                step = slots.decode_scheduled(req, pos)
+                length = rng.randint(1, width)
+                for g in range(groups):
+                    assert held[slots.row(base, groups, g, step)] == (req, g, pos - 1)
+                    for j in range(width):  # shorter requests still write their padded rows
+                        row = slots.row(base, groups, g, j)
+                        assert 0 < row < len(held) - 1
+                        held[row] = (req, g, pos + j) if j < length else ("padding", g, j)
+                pos += rng.randint(1, length)
+            slots.release(req)
+
+
+def test_width_one_is_the_plain_compact_layout():
+    slots = RecurrentStateSlots(1)
+    assert slots.total_rows(7, 4) == 7 * 4 + 2
+    for base in range(7):
+        for group in range(4):
+            assert slots.row(base, 4, group) == base * 4 + group + 1
