@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Slot arithmetic for compact recurrent (GDN, PLE) state, with room to rewind rejected speculative tokens.
+
+Each (request base slot, GDN group) owns ``width = 1 + num_speculative_tokens`` consecutive rows. A decode step that
+processes ``width`` tokens from position ``p`` leaves the state after token ``p + j`` in row ``j``. The next step
+starts at ``p' <= p + width`` (rejected tokens are scheduled again), so it resumes from row ``p' - p - 1``.
+
+With ``width == 1`` the rows are the plain compact layout, ``base * num_groups + group + 1`` (row 0 is unused).
+"""
+
+from __future__ import annotations
+
+
+class RecurrentStateSlots:
+
+    def __init__(self, width: int = 1):
+        assert width >= 1
+        self.width = width
+        self._row0_position: dict[str, int] = {}  # request -> position of the token whose state is in row 0
+
+    def total_rows(self, max_requests: int, num_groups: int) -> int:
+        """Rows to allocate: every request's rows, the unused row 0 and the padding row at the end."""
+        return max_requests * num_groups * self.width + 2
+
+    def row(self, base_slot: int, num_groups: int, group: int, step: int = 0) -> int:
+        return (base_slot * num_groups + group) * self.width + step + 1
+
+    def prefill_scheduled(self, req_id: str, start: int, length: int) -> None:
+        """A prefill chunk leaves only its final state, in row 0."""
+        if self.width > 1:
+            self._row0_position[req_id] = start + length - 1
+
+    def decode_scheduled(self, req_id: str, start: int) -> int:
+        """Record a decode step from position ``start`` and return the row index (0..width-1) to resume from."""
+        if self.width == 1:
+            return 0
+        step = start - self._row0_position[req_id] - 1
+        if not 0 <= step < self.width:
+            raise RuntimeError(f"cannot rewind the recurrent state of {req_id} to position {start}: it holds "
+                               f"positions {self._row0_position[req_id]} to "
+                               f"{self._row0_position[req_id] + self.width - 1}")
+        self._row0_position[req_id] = start
+        return step
+
+    def release(self, req_id: str) -> None:
+        self._row0_position.pop(req_id, None)
