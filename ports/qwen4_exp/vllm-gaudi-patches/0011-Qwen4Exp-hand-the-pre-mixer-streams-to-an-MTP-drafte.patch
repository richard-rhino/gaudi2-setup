From b1dc562f00af7dd2714248ea61050a9de2981cc6 Mon Sep 17 00:00:00 2001
From: richard-rhino <richard-rhino@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:11:29 +0000
Subject: [PATCH] Qwen4Exp: hand the pre-mixer streams to an MTP drafter

With speculative method "mtp" the model also returns its pre-mixer hidden
streams, which reach the drafter through the runner's aux hidden state path.
Output without MTP is unchanged.

Only the model's forward was tested, on CPU with stub layers. Not run on HPU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: richard-rhino <richard-rhino@users.noreply.github.com>
---
 vllm_gaudi/models/qwen4_exp.py           | 7 +++++++
 vllm_gaudi/v1/worker/hpu_model_runner.py | 6 +++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/vllm_gaudi/models/qwen4_exp.py b/vllm_gaudi/models/qwen4_exp.py
index 1be1ec45..cc7d8ca4 100644
--- a/vllm_gaudi/models/qwen4_exp.py
+++ b/vllm_gaudi/models/qwen4_exp.py
@@ -530,6 +530,7 @@ class HpuQwen4ExpModel(nn.Module):
             p.check_capacity()
             p.ple_slot = j
         self.ple_hasher = MultiNGramHasher([p.hasher for p in self.ple_layers]) if self.ple_layers else None
+        self.return_multi_stream = False  # MTP: the draft model starts from the pre-mixer hc streams
 
     @torch.no_grad()
     def _ple_prepare(self, input_ids: torch.Tensor) -> Optional[PLEStepInputs]:
@@ -641,6 +642,8 @@ class HpuQwen4ExpModel(nn.Module):
             self._layer_events(ev)
         if not pp.is_last_rank:
             return IntermediateTensors({"hidden_states": h})
+        if self.return_multi_stream:
+            return self.hyper_connection_mixer(h), [h]
         return self.hyper_connection_mixer(h)
 
 
@@ -690,6 +693,10 @@ class HpuQwen4ExpForConditionalGeneration(nn.Module, HasInnerState, IsHybrid, Su
     def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor | None:
         return self.logits_processor(self.lm_head, hidden_states)
 
+    def enable_mtp_hidden_state_outputs(self) -> None:
+        """Make forward return ``(sample [.., H], [multi [.., hc * H]])``, as the MTP draft model needs."""
+        self.model.return_multi_stream = True
+
     def get_mrope_input_positions(self, input_tokens, mm_features):
         positions = torch.arange(len(input_tokens), dtype=torch.long)
         return positions.unsqueeze(0).expand(3, -1), 0
diff --git a/vllm_gaudi/v1/worker/hpu_model_runner.py b/vllm_gaudi/v1/worker/hpu_model_runner.py
index 5fb5c62c..270383cc 100644
--- a/vllm_gaudi/v1/worker/hpu_model_runner.py
+++ b/vllm_gaudi/v1/worker/hpu_model_runner.py
@@ -5467,7 +5467,11 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
             with HabanaMemoryProfiler() as m:  # noqa: SIM117
                 #logger.info("Loading drafter model %s...", self.vllm_config.speculative_config.draft_model_config)
                 self.drafter.load_model(self.model.model)
-                if self.use_aux_hidden_state_outputs:
+                if (self.speculative_config.method == "mtp"
+                        and hasattr(self.model.model, "enable_mtp_hidden_state_outputs")):
+                    self.model.model.enable_mtp_hidden_state_outputs()
+                    self.use_aux_hidden_state_outputs = True
+                elif self.use_aux_hidden_state_outputs:
                     if supports_eagle3(self.model.model):
                         self.model.model.set_aux_hidden_state_layers(
                             self.model.model.get_eagle3_default_aux_hidden_state_layers())
-- 
