         quant_config = os.getenv("QUANT_CONFIG", None) is not None
         return (self.model_config.quantization == "inc" or quant_config)
 
+    def _constrain_logits(
+        self,
+        scheduler_output: "SchedulerOutput",
+        grammar_output: "GrammarOutput",
+        logits: torch.Tensor,
+        req_ids: list[str],
+        width: int = 1,
+    ) -> torch.Tensor:
+        """Grammar masks for speculative decoding, where each batch is constrained before its own sampler.
+
+        ``logits`` has ``width`` rows per request of ``req_ids``, then padding. The scheduler sends a block of
+        ``num_speculative_tokens + 1`` masks per structured output request, however many drafts it has.
+        """
+        stride = self.speculative_config.num_speculative_tokens + 1
+        blocks = {req_id: i * stride for i, req_id in enumerate(grammar_output.structured_output_request_ids)}
+        rows, mask_rows = [], []
+        for i, req_id in enumerate(req_ids):
+            if req_id not in blocks:
+                continue
+            for j in range(1 + len(scheduler_output.scheduled_spec_decode_tokens.get(req_id, []))):
+                rows.append(i * width + j)
+                mask_rows.append(blocks[req_id] + j)
+        if not rows:
+            return logits
+        index = torch.tensor(rows, device=logits.device)
+        selected = logits.index_select(0, index).cpu().to(torch.float32)
+        xgr_cpu.apply_token_bitmask_inplace_cpu(selected, torch.from_numpy(grammar_output.grammar_bitmask[mask_rows]))
+        return logits.index_copy(0, index, selected.to(logits.device, dtype=logits.dtype))
+
     # Copied from vllm/v1/worker/gpu_model_runner.py at vLLM 19b927e52d (file removed upstream)
     def apply_grammar_bitmask(
         self,
@@ -4967,7 +4996,8 @@ class HPUModelRunner(HpuKVConnectorModelRunnerMixin):
