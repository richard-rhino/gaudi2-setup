+# SPDX-License-Identifier: Apache-2.0
+"""Grammar masks with speculative decoding, in the layout the scheduler really sends."""
+
+from collections import namedtuple
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+from vllm.v1.structured_output import StructuredOutputManager
+from vllm_gaudi.v1.worker.hpu_model_runner import HPUModelRunner
+
+DEPTH, VOCAB = 3, 64
+_Bounds = namedtuple("_Bounds", "grammar_start constraint_start")
+
+
+class _Grammar:
+    """Allows exactly one token: its first one plus the number of tokens it has accepted."""
+
+    def __init__(self, first):
+        self.first, self.accepted = first, 0
+
+    def accept_tokens(self, req_id, tokens):
+        self.accepted += len(tokens)
+        return True
+
+    def is_terminated(self):
+        return False
+
+    def rollback(self, num_tokens):
+        self.accepted -= num_tokens
+
+
+def _grammar_output(firsts, drafts):
+    manager = SimpleNamespace(
+        vllm_config=SimpleNamespace(num_speculative_tokens=DEPTH, model_config=SimpleNamespace(is_diffusion=False)),
+        fill_bitmask_parallel_threshold=99,
+        _grammar_bitmask=torch.full((len(firsts) * (DEPTH + 1), VOCAB // 32), -1, dtype=torch.int32),
+        backend=None,
+        _get_constraint_bounds=lambda request, tokens: _Bounds(0, 0),
+        _masked_reasoning_ends=lambda request: ())
+
+    def fill(batch):
+        for grammar, row, apply, _ in batch:
+            manager._grammar_bitmask[row] = 0 if apply else -1
+            if apply:
+                token = grammar.first + grammar.accepted
+                word = np.array(1 << (token % 32), dtype=np.uint32).astype(np.int32)
+                manager._grammar_bitmask[row, token // 32] = int(word)
+
+    manager._fill_bitmasks = fill
+    requests = {
+        r: SimpleNamespace(structured_output_request=SimpleNamespace(grammar=_Grammar(first)))
+        for r, first in firsts.items()
+    }
+    bitmask = StructuredOutputManager.grammar_bitmask(manager, requests, list(firsts), drafts)
+    return SimpleNamespace(structured_output_request_ids=list(firsts), grammar_bitmask=np.asarray(bitmask))
+
+
+def _constrain(logits, req_ids, width, firsts, drafts):
+    runner = SimpleNamespace(speculative_config=SimpleNamespace(num_speculative_tokens=DEPTH))
+    return HPUModelRunner._constrain_logits(runner, SimpleNamespace(scheduled_spec_decode_tokens=drafts),
+                                            _grammar_output(firsts, drafts), logits, req_ids, width)
+
+
+def test_padded_spec_decode_batch():
+    # Not in batch order, different numbers of drafts, a free request in between
+    firsts = {"c": 20, "a": 5, "d": 40}
+    drafts = {"a": [5], "b": [1, 2], "c": [20, 21, 22]}
+    req_ids, width = ["a", "b", "c", "d"], DEPTH + 1
+    logits = _constrain(torch.zeros(6 * width, VOCAB, dtype=torch.bfloat16), req_ids, width, firsts, drafts)
+    for i in range(6):
+        req_id = req_ids[i] if i < len(req_ids) else None
+        for j in range(width):
+            allowed = logits[i * width + j].isfinite().nonzero().flatten().tolist()
+            if req_id in firsts and j <= len(drafts.get(req_id, [])):
+                assert allowed == [firsts[req_id] + j], (req_id, j)
+            else:
+                assert len(allowed) == VOCAB, (req_id, j)
+
+
+def test_prefill_and_steps_without_drafts():
+    firsts = {"a": 7, "b": 9, "c": 33}
+    logits = _constrain(torch.zeros(4, VOCAB), ["c", "x", "b"], 1, firsts, {})
+    assert [logits[i].isfinite().sum() for i in range(4)] == [1, VOCAB, 1, VOCAB]
+    assert logits[0].argmax() == 33 and logits[2].argmax() == 9
