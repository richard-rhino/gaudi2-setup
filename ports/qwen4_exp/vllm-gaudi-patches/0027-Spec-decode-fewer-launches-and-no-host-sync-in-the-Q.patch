@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: Apache-2.0
+"""HPUModelRunner._regional_compilation: methods and submodules named in ``hpu_compile_regions``."""
+from types import SimpleNamespace
+
+import torch
+
+from vllm_gaudi.v1.worker.hpu_model_runner import HPUModelRunner
+
+
+class Norm(torch.nn.Module):
+    pass
+
+
+class Glue(torch.nn.Module):
+    hpu_compile_regions = ("project", "mixer")
+
+    def __init__(self):
+        super().__init__()
+        self.mixer = torch.nn.Sequential(Norm(), torch.nn.Linear(2, 2))
+        self.other = torch.nn.Sequential(Norm())
+        self.layers = torch.nn.ModuleList([torch.nn.Linear(2, 2), torch.nn.Linear(2, 2)])
+
+    def project(self, x):
+        return x
+
+
+def _compiled_names(model):
+    seen = []
+    runner = SimpleNamespace(regional_compilation_layers_list=[Norm])
+    runner._compile_region = lambda parent, name, module: seen.append((type(parent).__name__, name))
+    runner._regional_compilation = lambda *a: HPUModelRunner._regional_compilation(runner, *a)
+    runner._regional_compilation(model)
+    return seen
+
+
+def test_named_regions_compiled_once_and_not_descended():
+    seen = _compiled_names(Glue())
+    assert ("Glue", "project") in seen and ("Glue", "mixer") in seen
+    # the named submodule is one region: its Norm child is not compiled again (only `other`'s Norm is)
+    assert seen.count(("Sequential", "0")) == 1
+    assert ("ModuleList", "0") in seen and ("ModuleList", "1") in seen
+
+
+def test_without_regions_unchanged():
+    m = Glue()
+    Glue.hpu_compile_regions, saved = (), Glue.hpu_compile_regions
+    try:
+        seen = _compiled_names(m)
+    finally:
+        Glue.hpu_compile_regions = saved
+    assert ("Glue", "project") not in seen and ("Glue", "mixer") not in seen
+    assert seen.count(("Sequential", "0")) == 2  # both Norms, the mixer's included
