@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: Apache-2.0
+"""HPUModelRunner._host_token_inputs: host copies of a decode batch's ids and of each row's last tokens."""
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from vllm_gaudi.v1.worker.hpu_model_runner import HPUModelRunner
+
+
+def _runner(k: int, async_scheduling: bool = False):
+    hist = np.zeros((4, 16), dtype=np.int32)
+    hist[0, :5] = [11, 12, 13, 14, 15]
+    hist[1, :2] = [21, 22]
+    r = SimpleNamespace(use_async_scheduling=async_scheduling,
+                        input_batch=SimpleNamespace(token_ids_cpu=hist),
+                        get_model=lambda: SimpleNamespace(host_context_tokens=k))
+    return r
+
+
+def _call(r, token_ids, num_decodes, padded, context_lens, sched=object()):
+    return HPUModelRunner._host_token_inputs(r, token_ids, num_decodes, padded, np.array(context_lens), sched)
+
+
+def test_last_tokens_and_padding():
+    ids = torch.tensor([[15], [22], [0]], dtype=torch.int32)
+    flat, prev = _call(_runner(3), ids, 2, 3, [4, 1])
+    assert flat.tolist() == [15, 22, 0]
+    # row 0: tokens before position 4 -> [12, 13, 14]; row 1: one token, left-padded; row 2: padding row
+    assert prev.tolist() == [[12, 13, 14], [-1, -1, 21], [-1, -1, -1]]
+
+
+def test_spec_decode_rows_are_per_sequence():
+    ids = torch.tensor([[14], [15], [21], [22]], dtype=torch.int32)  # 2 sequences x 2 tokens, flattened
+    flat, prev = _call(_runner(2), ids, 2, 2, [3, 1])
+    assert flat.tolist() == [14, 15, 21, 22]
+    assert prev.tolist() == [[12, 13], [-1, 21]]
+
+
+@pytest.mark.parametrize("k,async_scheduling,sched", [(0, False, object()), (3, True, object()), (3, False, None)])
+def test_disabled(k, async_scheduling, sched):
+    ids = torch.tensor([[15]], dtype=torch.int32)
+    assert _call(_runner(k, async_scheduling), ids, 1, 1, [4], sched) == (None, None)
