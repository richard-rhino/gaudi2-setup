@@ -690,6 +726,12 @@ class HpuQwen4ExpForConditionalGeneration(nn.Module, HasInnerState, IsHybrid, Su
     def forward(self, input_ids, positions, intermediate_tensors=None, inputs_embeds=None, **kwargs):
