+    def _host_token_inputs(self, token_ids: torch.Tensor, num_decodes: int, padded_batch_size: int, context_lens,
+                           scheduler_output) -> tuple[Optional[torch.Tensor], Optional[torch.Tensor]]:
+        """Host copies of a decode batch's tokens, for models that hash tokens on the CPU (``host_context_tokens``
+        > 0, e.g. Qwen4Exp's n-gram embedding), so they need not read them back from the device. Returns the flat
+        input ids and, per row, the last ``k`` tokens before its first input token (-1 before position 0 and on
+        padding rows). Not under async scheduling, where the host ids of the newest tokens lag the device."""
+        k = self.__dict__.get("_host_ctx_k")
+        if k is None:
+            k = self._host_ctx_k = int(getattr(self.get_model(), "host_context_tokens", 0) or 0)
+        if k <= 0 or scheduler_output is None or self.use_async_scheduling:
+            return None, None
+        prev = torch.full((padded_batch_size, k), -1, dtype=torch.int64)
+        rows = self.input_batch.token_ids_cpu
+        for i in range(num_decodes):
+            c = int(context_lens[i])
+            lo = max(0, c - k)
+            if c > lo:
+                prev[i, k - (c - lo):] = torch.from_numpy(rows[i, lo:c])
+        return token_ids.reshape(-1), prev
+
     def _prepare_decode_inputs(self,
                                num_decodes,
                                num_scheduled_tokens,
