 vllm_gaudi/v1/sample/hpu_noise.py             | 26 +++++++++++++++++++
 vllm_gaudi/v1/sample/hpu_random_sample.py     |  9 ++-----
 vllm_gaudi/v1/sample/hpu_rejection_sampler.py | 11 +++-----
 4 files changed, 49 insertions(+), 15 deletions(-)
 create mode 100644 vllm_gaudi/v1/sample/hpu_noise.py

