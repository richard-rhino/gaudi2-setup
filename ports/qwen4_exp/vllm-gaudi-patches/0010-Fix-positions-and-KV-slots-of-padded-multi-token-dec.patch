+# SPDX-License-Identifier: Apache-2.0
+"""Positions and KV slots for decode steps where requests schedule different numbers of tokens (speculative decode).
+
+Such a step is padded to ``[batch, width]``, width being the longest request's token count, and then flattened.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterator, Sequence
+
+import torch
+
+
+def mrope_decode_positions(context_lens: Sequence[int], token_counts: Sequence[int], deltas: Sequence[int],
+                           batch: int, width: int) -> torch.Tensor:
+    """``[3, batch * width]`` positions of the scheduled tokens, -1 for padding. Past the prompt all axes are equal."""
+    positions = torch.full((batch, width), -1, dtype=torch.int32, device='cpu')
+    for i, (start, count, delta) in enumerate(zip(context_lens, token_counts, deltas)):
+        first = int(start) + int(delta)
+        positions[i, :count] = torch.arange(first, first + count, dtype=torch.int32, device='cpu')
+    return positions.flatten().repeat(3, 1)
+
+
+def redirect_padded_tokens(slot_mapping: torch.Tensor, token_counts: Sequence[int],
+                           pad_slots: Iterator[int]) -> None:
+    """Point each request's padded tokens at the pad row. Their position is 0, whose slot is a live cache entry."""
+    width = slot_mapping.shape[1]
+    for i, count in enumerate(token_counts):
+        for j in range(count, width):
+            slot_mapping[i, j] = next(pad_slots)
