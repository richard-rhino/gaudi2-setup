+# SPDX-License-Identifier: Apache-2.0
+"""CPU tests for the padding of multi-token decode steps."""
+
+from __future__ import annotations
+
+import itertools
+import random
+
+import pytest
+import torch
+
+from vllm_gaudi.v1.worker.decode_token_padding import mrope_decode_positions, redirect_padded_tokens
+
+
+@pytest.mark.parametrize("width", [1, 2, 4])
+@pytest.mark.parametrize("seed", range(50))
+def test_only_scheduled_tokens_reach_live_slots(width, seed):
+    rng = random.Random(seed)
+    n, pad_rows = rng.randint(1, 8), rng.randint(0, 3)
+    counts = [rng.randint(1, width) for _ in range(n)]
+    starts = [rng.randint(0, 5000) for _ in range(n)]
+    deltas = [rng.randint(-9, 9) for _ in range(n)]
+    pos = mrope_decode_positions(starts, counts, deltas, n + pad_rows, width)
+    assert pos.shape == (3, (n + pad_rows) * width)
+    live = torch.arange(1, n * width + 1).view(n, width)
+    slots = live.clone()
+    redirect_padded_tokens(slots, counts, itertools.cycle(range(90000, 90128)))
+    for i in range(n + pad_rows):
+        for j in range(width):
+            real = i < n and j < counts[i]
+            want = starts[i] + deltas[i] + j if real else -1
+            assert pos[:, i * width + j].tolist() == [want] * 3
+            if i < n:
+                assert int(slots[i, j]) == int(live[i, j]) if real else 90000 <= int(slots[i, j]) < 90128
