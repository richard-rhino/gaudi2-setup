+def patch_worker_module_order():
+    """VLLM_HPU_MODULE_ORDER="0,1,...,7": start local worker i with HLS_MODULE_ID=<i-th entry> (sysfs module_id).
+
+    Without it every worker opens whichever card is free first, so the rank -> card mapping (and with PP, which
+    physical links the stage-to-stage hops use) changes from start to start. The PyTorch bridge opens the card named
+    by HLS_MODULE_ID; HABANA_VISIBLE_MODULES only reaches it through initialize_distributed_hpu(), which vLLM does not
+    call. The worker opens the device before init_device, so the variable is set when the process is spawned."""
+    order = [m.strip() for m in os.environ.get("VLLM_HPU_MODULE_ORDER", "").split(",") if m.strip()]
+    if not order:
+        return
+    from vllm.v1.executor import multiproc_executor as mpe
+
+    import threading
+
+    orig = mpe.WorkerProc.make_worker_process
+    if getattr(orig, "_hpu_module_order", False):
+        return
+    lock = threading.Lock()  # workers may be started from several threads; os.environ is process-wide
+
+    def make_worker_process(*args, **kwargs):
+        local_rank = kwargs.get("local_rank", args[1] if len(args) > 1 else None)
+        if local_rank is None or local_rank >= len(order):
+            return orig(*args, **kwargs)
+        with lock:
+            prev = os.environ.get("HLS_MODULE_ID")
+            os.environ["HLS_MODULE_ID"] = order[local_rank]
+            try:
+                return orig(*args, **kwargs)
+            finally:
+                if prev is None:
+                    os.environ.pop("HLS_MODULE_ID", None)
+                else:
+                    os.environ["HLS_MODULE_ID"] = prev
+
+    make_worker_process._hpu_module_order = True
+    mpe.WorkerProc.make_worker_process = staticmethod(make_worker_process)
